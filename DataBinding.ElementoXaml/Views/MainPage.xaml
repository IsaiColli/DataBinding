<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DataBinding.ElementoXaml.Views.MainPage"
             Title="MainPage">
    <VerticalStackLayout
        Padding="24"
        Spacing="16">
        <Label
            Text="Escribe lo que sea"/>
        <Entry
            BackgroundColor="Gray"
            x:Name="TextoEntry"/>
        <Label
            Text="Esto es lo que escribiste"/>
        <Label
            Text="{Binding Source={x:Reference TextoEntry}, Path=Text}"
            HorizontalOptions="Center"
            FontAttributes="Italic"/>
    </VerticalStackLayout>
</ContentPage>